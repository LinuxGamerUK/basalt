# Basalt ghostty config — the full terminal configuration with the live
# palette inline. Generated by matugen; do not edit.
# Written to ~/.config/ghostty/config (MUTABLE — ghostty watches this
# file and hot-applies changes, which is what makes wallpaper switches
# recolor open terminals).
#
# House settings: JetBrains Mono Nerd Font Propo 14, 0.85 opacity.
background-opacity = 0.85
font-family = JetBrainsMono Nerd Font
font-size = 14
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}

# 16 ANSI colors — M3 tonal mapping
palette = 0=#000000
palette = 1=#CC6666
palette = 2=#66CC66
palette = 3=#CCCC66
palette = 4={{colors.primary.default.hex}}
palette = 5=#CC66CC
palette = 6={{colors.secondary.default.hex}}
palette = 7=#CCCCCC
palette = 8={{colors.surface_container_high.default.hex}}
palette = 9={{colors.error.default.hex}}
palette = 10={{colors.secondary.default.hex}}
palette = 11={{colors.tertiary.default.hex}}
palette = 12={{colors.primary_container.default.hex}}
palette = 13={{colors.secondary_container.default.hex}}
palette = 14={{colors.tertiary_container.default.hex}}
palette = 15={{colors.on_surface.default.hex}}