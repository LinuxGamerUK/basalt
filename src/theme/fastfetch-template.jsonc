{
  // Basalt palette for fastfetch — generated by matugen.
  // Included by the HM fastfetch config; display.color values are
  // referenced by the module keys ("1", "2", ...) in that config.
  "display": {
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.secondary.default.hex}}",
      "3": "{{colors.tertiary.default.hex}}",
      "4": "{{colors.error.default.hex}}"
    }
  }
}